# CleanLoop settings. Copy this file to ".env" and fill in what you need.
# Everything is optional - the app works fully without any of these.

# Port the app runs on
PORT=8080

# Demo helpers for judges: quick demo logins, gallery/demo photos on laptops,
# "simulate arrival" for workers, reset demo data. Set to false for real use.
DEMO_MODE=true

# Secret used to sign login tokens. Change it to any long random text when deploying.
APP_SECRET=change-me-to-a-long-random-string

# ---- Cloud AI (optional) ----------------------------------------------------
# Free key: https://aistudio.google.com/apikey
# With a key, Gemini analyses severity, volume, hazards and items, and verifies
# before/after cleanup photos. Without it, the on-device model is used.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# auto = use Gemini when a key is set, offline = always on-device only
AI_PROVIDER=auto

# ---- Real integrations (optional, simulated when empty) ---------------------
# Each URL receives a JSON POST. See server/integrations.js to adapt to a provider.
PAYOUT_WEBHOOK_URL=
SMS_WEBHOOK_URL=
VEHICLE_LOOKUP_URL=
CORPORATION_WEBHOOK_URL=
